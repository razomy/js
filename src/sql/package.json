    "text",
    "string16",
    "string32",
    "string64",
    "string128",
    "string255",
    "char2",
    "char3",
    "smallint",
    "int",
    "bigint",
    "decimal",
    "double",
    "bool",
    "date",
    "timestamp",
    "uuidPk",
    "jsonb",
    "stringArray",
    "textArray",
    "typeMap"
