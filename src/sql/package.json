      },
      "import": {
        "default": "./index.ts",
        "types": "./index.ts"
      },
      "require": {
        "default": "./index.ts",
        "types": "./index.ts"
      }
    },
    "./entity": {
      "default": {
        "default": "./entity/index.ts",
        "types": "./entity/index.ts"
      },
      "import": {
        "default": "./entity/index.ts",
        "types": "./entity/index.ts"
      },
      "require": {
        "default": "./entity/index.ts",
        "types": "./entity/index.ts"
      }
    },
    "./migration": {
      "default": {
        "default": "./migration/index.ts",
        "types": "./migration/index.ts"
      },
      "import": {
        "default": "./migration/index.ts",
        "types": "./migration/index.ts"
      },
      "require": {
        "default": "./migration/index.ts",
        "types": "./migration/index.ts"
      }
    },
    "./package.json": "./package.json",
    "./specifications/*": "./specifications/*"
  },
  "files": [
    "*"
  ],
  "homepage": "https://github.com/razomy/js/tree/main/src/sql#readme",
  "keywords": [
    "razomy",
    "sql",
    "defineTable",
    "i18N",
    "toSnake",
    "createEntityProxy",
    "generateEntitiesFile",
    "buildCreateTableSql",
    "generateInitialMigrations",
    "getTargetStateFromSchema",
    "getUpFiles",
