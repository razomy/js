  },
  "repository": {
    "directory": "src/domains",
    "type": "git",
    "url": "git+https://github.com/razomy/js.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown index.ts fs/index.ts patterns/index.ts --watch",
