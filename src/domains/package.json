        "default": "./index.ts",
        "types": "./index.ts"
      },
      "require": {
        "default": "./index.ts",
        "types": "./index.ts"
      }
    },
    "./fs": {
      "default": {
        "default": "./fs/index.ts",
        "types": "./fs/index.ts"
      },
      "import": {
        "default": "./fs/index.ts",
        "types": "./fs/index.ts"
      },
      "require": {
        "default": "./fs/index.ts",
        "types": "./fs/index.ts"
      }
    },
    "./package.json": "./package.json",
    "./patterns": {
      "default": {
        "default": "./patterns/index.ts",
        "types": "./patterns/index.ts"
      },
      "import": {
        "default": "./patterns/index.ts",
        "types": "./patterns/index.ts"
      },
      "require": {
        "default": "./patterns/index.ts",
        "types": "./patterns/index.ts"
      }
    },
    "./specifications/*": "./specifications/*"
  },
  "files": [
    "*"
  ],
  "homepage": "https://github.com/razomy/js/tree/main/src/domains#readme",
  "keywords": [
    "razomy",
    "domains",
    "validateFsNodeCycle",
    "boolDefault",
    "createAt",
