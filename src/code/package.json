        "default": "./index.ts",
        "types": "./index.ts"
      },
      "require": {
        "default": "./index.ts",
        "types": "./index.ts"
      }
    },
    "./package.json": "./package.json",
    "./specifications/*": "./specifications/*"
  },
  "files": [
    "*"
  ],
  "homepage": "https://github.com/razomy/js/tree/main/src/code#readme",
  "keywords": [
    "razomy",
    "code",
    "formatProject",
    "publish"
  ],
  "license": "MIT",
  "main": "./index.ts",
  "module": "./index.ts",
  "name": "@razomy/code",
  "peerDependencies": {
    "@razomy/main": "*",
    "@razomy/npm": "*",
    "@razomy/shell": "*",
    "@razomy/ts-refactor": "*",
    "@razomy/ts-refactor-project": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "src/code",
    "type": "git",
    "url": "git+https://github.com/razomy/js.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown index.ts --watch",
