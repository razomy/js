{
  "author": {
    "email": "yevhenii.kamenskyi+js@razomy.org",
    "name": "Yevhenii Kamenskyi",
    "url": "https://id.razomy.org/yevhenii-kamenskyi"
  },
  "dependencies": {},
  "description": "A powerful Nuxt SDK providing a comprehensive suite of reusable Vue components",
  "devDependencies": {
    "@nuxt/devtools": "^3.4.4",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.6.2",
    "@types/node": "^26.6.5",
    "changelogen": "^0.6.2",
    "vue-tsc": "^3.3.13",
    "@nuxt/kit": "^4.6.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^7.0.2",
    "@nuxtjs/sitemap": "^9.1.0",
    "@razomy/schema": "^0.0.1-alpha.4",
    "@razomy/schemas": "^0.0.1-alpha.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.2",
    "nuxt-gtag": "^5.0.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "vuetify": "^4.3.0",
    "vuetify-nuxt-module": "^1.0.0-rc.6"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./module": {
      "import": "./src/module.ts",
      "types": "./src/module.ts"
    },
    "./locales/*": "./locales/*",
    "./runtime/pages/*": "./src/runtime/pages/*",
    "./runtime/apps/*": "./src/runtime/apps/*",
    "./runtime/layouts/*": "./src/runtime/layouts/*",
    "./runtime/components/*": "./src/runtime/components/*",
    "./runtime/functions": {
      "import": "./src/runtime/functions/index.ts",
      "types": "./src/runtime/functions/index.ts"
    },
    "./runtime/functions/server": {
      "import": "./src/runtime/functions/server/index.ts",
      "types": "./src/runtime/functions/server/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "locales"
  ],
  "homepage": "https://github.com/razomy/js/razomy/nuxt#readme",
  "keywords": [
    "razomy",
    "nuxt"
  ],
  "license": "MIT",
  "name": "@razomy/nuxt",
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "src/nuxt",
    "type": "git",
    "url": "git+https://github.com/razomy/js.git"
  },
  "scripts": {
    "build": "nuxt-module-build build && cp -r ./locales ./dist/locales && cp package_dist.json ./dist/package.json",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm stage publish && git push --follow-tags",
    "start": "nuxt-module-build build --stub && nuxt-module-build prepare"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.1-alpha.9"
}
