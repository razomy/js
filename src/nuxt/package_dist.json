{
  "author": {
    "email": "yevhenii.kamenskyi+js@razomy.org",
    "name": "Yevhenii Kamenskyi",
    "url": "https://id.razomy.org/yevhenii-kamenskyi"
  },
  "dependencies": {
    "vue-i18n": "^11.4.16"
  },
  "description": "A powerful Nuxt SDK providing a comprehensive suite of reusable Vue components",
  "devDependencies": {
    "@nuxt/devtools": "^3.2.3",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.2",
    "@types/node": "^25.5.0",
    "changelogen": "^0.6.2",
    "vue-tsc": "^3.3.13",
    "@nuxt/kit": "^4.6.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^9.1.0",
    "@razomy/schema": "^0.0.1-alpha.4",
    "@razomy/schemas": "^0.0.1-alpha.4",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "nuxt": "^4.6.2",
    "nuxt-gtag": "^5.0.0",
    "vue": "^3.5.44",
    "vue-i18n": "^10.0.0 || ^11.0.0",
    "vue-router": "^5.4.0",
    "vuetify": "^4.2.6",
    "vuetify-nuxt-module": "^1.0.0-rc.6"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    "./module": {
      "import": "./module.mjs",
      "types": "./module.d.mts"
    },
    "./locales/*": "./locales/*",
    "./runtime/pages/*": "./runtime/pages/*",
    "./runtime/apps/*": "./runtime/apps/*",
    "./runtime/layouts/*": "./runtime/layouts/*",
    "./runtime/components/*": "./runtime/components/*",
    "./runtime/functions": {
      "import": "./runtime/functions/index.js",
      "types": "./runtime/functions/index.d.ts"
    },
    "./runtime/functions/server": {
      "import": "./runtime/functions/server/index.js",
      "types": "./runtime/functions/server/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "*"
  ],
  "homepage": "https://github.com/razomy/js/razomy/nuxt#readme",
  "keywords": [
    "razomy",
    "nuxt"
  ],
  "license": "MIT",
  "name": "@razomy/nuxt",
  "peerDependencies": {
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "src/nuxt",
    "type": "git",
    "url": "git+https://github.com/razomy/js.git"
  },
  "scripts": {
    "build": "nuxt-module-build build && cp -r ./locales ./dist/locales && cp package.json ./dist/package.json",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "start": "nuxt-module-build build --stub && nuxt-module-build prepare"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.0.1-alpha.9"
}
