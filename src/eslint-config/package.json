  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "description": "",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "default": {
        "default": "./index.ts",
        "types": "./index.ts"
      },
      "import": {
        "default": "./index.ts",
        "types": "./index.ts"
      },
      "require": {
        "default": "./index.ts",
        "types": "./index.ts"
      }
    },
    "./package.json": "./package.json",
    "./specifications/*": "./specifications/*"
  },
  "files": [
    "*"
  ],
  "homepage": "https://github.com/razomy/js/tree/main/src/eslint-config#readme",
  "keywords": [
    "razomy",
    "eslint",
    "config"
  ],
  "license": "MIT",
  "main": "./index.ts",
  "module": "./index.ts",
  "name": "@razomy/eslint-config",
  "peerDependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "directory": "src/eslint-config",
    "type": "git",
    "url": "git+https://github.com/razomy/js.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown index.ts --watch",
    "prepublishOnly": "npm run build"
  },
  "sideEffects": false,
  "tsdown": [
    {
      "dts": true,
      "entry": [
        "index.ts"
      ],
      "format": "esm,cjs",
      "platform": "neutral"
    }
  ],
  "type": "module",
  "types": "./index.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./index.ts"
      ]
    }
  },
  "version": "0.0.1-alpha.4"
}
