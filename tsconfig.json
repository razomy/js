{
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "dom"
    ],
    "types": [
      "vitest/globals"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedParameters": false,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "target": "esnext",
    "paths": {
      "razomy": [
        "./src/index.ts"
      ],
      "@razomy/*": [
        "./src/*/index.ts"
      ]
    }
  },
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/coverage",
    "./src/nuxt",
    "./src/vue",
    "./src/vue-resource",
    "./src/hir-vue",
    "./src/code-vue-playground",
    "./src/code-nuxt-playground",
    "./src/shell",
    "./src/cloud-db-pg"
  ],
  "references": [
    {
      "path": "./src/nuxt/tsconfig.json"
    }
  ]
}
